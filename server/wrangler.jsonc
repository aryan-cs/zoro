{
  // The rest timer's push notifications for Zoro (see src/index.js).
  "name": "zoro-server",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "durable_objects": { "bindings": [{ "name": "RESTS", "class_name": "Rest" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Rest"] }],
  "vars": {
    "APP_URL": "https://aryan-cs.github.io/zoro/",
    "ALLOWED_ORIGINS": "https://aryan-cs.github.io,http://127.0.0.1:4790,http://localhost:5173",
    // The VAPID public key (the app has the same one); the private key is a secret (wrangler secret put VAPID_PRIVATE).
    "VAPID_PUBLIC": "BKEuU25jkR8uXnGtJOP-Z4B66pP7brUjaMxRq3fldieufkTTs2rirOnyRC33EHXoGDz8UuVgykCkTJ6sYrpXnOk"
  },
  "observability": { "enabled": true }
}
